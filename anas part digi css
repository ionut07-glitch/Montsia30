body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    height: 100%; 
    overflow: hidden;
    box-sizing: border-box;
    color: #333;
    background-color: white; 
}

.carousel-container-full {
    position: relative;
    width: 100%;
    height: 100%; 
    background-color: white;
    box-sizing: border-box;
    padding: 10px; 
    overflow: hidden;
}

/* CANVI CLAU AQUÍ: Augmentat el padding lateral (40px) */
.slide {
    display: none;
    width: 100%;
    height: 100%;
    padding: 15px 40px; 
    box-sizing: border-box;
    line-height: 1.5;
    font-size: 0.95em;
    overflow-y: hidden;
}

.title-main {
    color: #493322;
    font-size: 1.6em;
    border-left: 5px solid #d8c0a8;
    padding-left: 15px;
    margin-bottom: 20px;
    font-weight: bold; 
    line-height: 1.2;
}

.nav-btn {
    cursor: pointer;
    position: absolute;
    top: 50%;
    padding: 18px;
    margin-top: -25px;
    color: #493322; 
    font-weight: bold;
    font-size: 24px;
    transition: 0.3s;
    border: none;
    background-color: rgba(230, 210, 190, 0.8);
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    opacity: 0.9;
}

.prev {
    left: 0;
    border-radius: 0 4px 4px 0;
}

.next {
    right: 0;
    border-radius: 4px 0 0 4px;
}

.nav-btn:hover {
    background-color: rgba(123, 88, 59, 0.9);
    color: white;
}

.box-light-background {
    background-color: #f7f3ef; 
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 25px;
    overflow: auto;
}

.icon-header-float {
    float: left;
    width: 60px; 
    height: 60px;
    margin-right: 15px;
    line-height: 1;
}
.placeholder-icon {
    width: 100%;
    height: auto;
    max-height: 60px;
    opacity: 0.5; 
}

.content-split-page1 {
    display: flex;
    gap: 30px;
}
.content-split-page1 .split-left {
    flex: 1;
    border-right: 1px solid #d1b499;
    padding-right: 20px;
    overflow-y: auto; 
}
.content-split-page1 .split-right {
    flex: 1;
    padding-left: 10px;
    overflow-y: auto;
}

.title-split {
    color: #7b583b;
    font-size: 1.2em;
    font-weight: bold;
    border-bottom: 1px solid #d8c0a8;
    padding-bottom: 5px;
    margin-top: 20px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
}

.icon-split-header {
    width: 30px;
    height: 30px;
    display: inline-block;
    vertical-align: middle;
    margin-right: 10px;
    opacity: 0.7;
}
.icon-gear::before { content: '⚙️'; font-size: 1.5em; color: #d1b499; }
.icon-scale::before { content: '⚖️'; font-size: 1.5em; color: #d1b499; }

.big-list {
    list-style: none;
    padding: 0;
    counter-reset: item;
}

.big-list li {
    counter-increment: item;
    margin-bottom: 18px;
    padding-left: 45px; 
    position: relative;
    font-size: 0.95em;
}

.big-list li::before {
    content: counter(item);
    font-size: 2.2em;
    font-weight: bold;
    color: #493322; 
    position: absolute;
    left: 0;
    top: -5px;
    line-height: 1;
}

.list-benefits {
    list-style-type: none;
    padding-left: 0; 
    margin-top: 5px;
}

.list-benefits li {
    padding-left: 50px;
    position: relative;
    margin-bottom: 18px;
    font-size: 0.95em;
}

.icon-benefit {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    opacity: 0.7;
}

.icon-user::before { content: '👤'; font-size: 2.2em; color: #d1b499; }
.icon-cart::before { content: '🛒'; font-size: 2.2em; color: #d1b499; }
.icon-heart::before { content: '🔗'; font-size: 2.2em; color: #d1b499; }

.content-split-page4 {
    display: flex;
    gap: 30px;
}

.col-left-page4 {
    flex: 2;
    overflow-y: auto;
}

.col-right-page4 {
    flex: 1;
    padding-left: 20px; 
    border-left: 1px solid #d8c0a8; 
}

.title-split-alt {
    background-color: #d8c0a8;
    color: #493322;
    font-weight: bold;
    padding: 8px 10px;
    margin-top: 0;
    margin-bottom: 10px;
    font-size: 1.1em;
}

.list-info {
    list-style-type: none;
    padding-left: 10px;
    margin-top: 10px;
    font-size: 0.95em;
}
.list-info li, .list-note li {
    position: relative;
    paddinag-left: 15px;
    margin-bottom: 8px;
}
.list-info li::before, .list-note li::before {
    content: "|";
    color: #d8c0a8;
    font-size: 1.5em;
    position: absolute;
    left: 0;
    top: -3px;
    font-weight: bold;
}

.list-note {
    list-style: none;
    padding-left: 10px; 
    margin-top: 10px;
    font-size: 0.95em;
}

.video-preview {
    text-align: center;
    padding-bottom: 10px;
}

.image-video {
    max-width: 100%; 
    height: auto; 
    border: 2px solid #7b583b;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}

.list-video-items {
    list-style: none;
    padding-left: 10px;
    margin-top: 5px;
    font-size: 0.95em;
    font-weight: normal;
}
.list-video-items li {
    position: relative;
    padding-left: 15px;
    margin-bottom: 3px;
}
.list-video-items li::before {
    content: "■";
    color: #333; 
    font-size: 0.8em;
    position: absolute;
    left: 0;
    top: 0;
    font-weight: bold;
}

.intro-section-new {
    background-color: #f7f3ef;
    padding: 10px 15px 5px 15px; 
    border-radius: 4px;
    margin-bottom: 5px; 
}

.intro-text-page-new {
    font-size: 1.05em;
    margin-bottom: 10px; 
}
.intro-text-page-new strong {
    color: #493322;
}


.content-split-page-new {
    display: flex;
    gap: 20px;
    margin-bottom: 10px; 
}
.content-split-page-new .column-new {
    flex: 1;
    border-left: 2px solid #d8c0a8;
    padding-left: 10px;
}
.content-split-page-new .column-new:first-child {
    border-left: none;
}
.content-split-page-new .column-new p {
    font-size: 0.9em;
    line-height: 1.4;
}
.title-column-new {
    font-size: 1em;
    font-weight: bold;
    color: #493322;
    margin: 0 0 5px 0;
}

.box-brown-header {
    background-color: #d1b499;
    color: #493322;
    font-weight: bold;
    padding: 10px 15px;
    margin-bottom: 5px; 
    border-radius: 4px;
    font-size: 1.1em;
    position: relative;
    text-align: center;
}
.icon-header-float-new {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5em;
}


.content-split-ideas {
    display: flex;
    gap: 15px;
    overflow: visible;
}

.column-idea {
    flex: 1;
    border-right: 1px dashed #d8c0a8;
    padding-right: 15px;
    font-size: 0.9em;
    overflow-y: visible;
}
.column-idea:last-child {
    border-right: none;
    padding-right: 0;
}

.title-idea {
    font-size: 1.05em;
    font-weight: bold;
    color: #7b583b;
    margin: 0 0 8px 0;
}


.column-idea-with-image {
    display: block;
    overflow-y: visible;
}

.image-area-new {
    float: right;
    width: 45%; 
    text-align: right;
    margin-left: 10px;
    margin-bottom: 10px;
}

.image-mobile-new {
    max-width: 100%;
    height: auto;
    max-height: 170px;
}

.image-caption {
    font-size: 0.8em;
    color: #493322;
    margin-top: 5px;
    text-align: right;
    width: 100%;
    line-height: 1.2;
}
